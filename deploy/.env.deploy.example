# 复制为 deploy/.env 后使用（勿提交真实密钥）
JZX_HOST_PORT=8080
JZX_SERVER_AUTH_TOKEN=replace-with-long-random-token
JZX_SERVER_AUTH_EXPIRES_AT=replace-with-UTC-ISO-timestamp-from-access-output
# 访问说明用
JZX_PUBLIC_BASE_URL=http://YOUR_PUBLIC_IP:8080
JZX_ACCESS_VALID_DAYS=30

# 登录后在设置中配置自定义供应商；简单注入 API Key 不会自动注册模型。
